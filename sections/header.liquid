{% assign marquee_text = section.settings.marquee_text %}

<div class="hero-banner-{{ section.id }}">

  <div class="hero-banner__topbar">
      <span class="hero-banner__shop-name">{{ section.settings.shop_name }}</span>
      
      <span class="hero-banner__topbar-spacer" aria-hidden="true">{{ section.settings.shop_banner }}</span>

      <a href="{{ section.settings.buttonShop_link }}" class="hero-banner__button_topBar">
          <span class="hero-banner__button-label">
            {{ section.settings.button_label_topbar }}
            <span aria-hidden="true">&rarr;</span>
          </span>
      </a>
  </div>

  <div class="hero-banner__text">
    <h1 class="hero-banner__heading">{{ section.settings.heading }}</h1>
    {% if section.settings.description != blank %}
      <p class="hero-banner__description">{{ section.settings.description }}</p>
    {% endif %}
  </div>

  <div class="hero-banner__media">
    {% if section.settings.background_image %}
      <img
        class="hero-banner__image"
        src="{{ section.settings.background_image | image_url: width: 1600 }}"
        alt="{{ section.settings.background_image.alt | escape }}"
        loading="lazy"
      >
    {% endif %}

    {% if section.settings.button_link != blank %}
      <a href="{{ section.settings.button_link }}" class="hero-banner__button">
        <span class="hero-banner__button-label">
          {{ section.settings.button_label }}
          <span aria-hidden="true">&rarr;</span>
        </span>
      </a>
    {% else %}
      <span class="hero-banner__button hero-banner__button--disabled">
        <span class="hero-banner__button-label">
          {{ section.settings.button_label }}
          <span aria-hidden="true">&rarr;</span>
        </span>
      </span>
    {% endif %}
  </div>

  {% if marquee_text != blank %}
    <div class="hero-banner__marquee">
        <span>{{ marquee_text }}</span>
    </div>
  {% endif %}

</div>

{% style %}
  .hero-banner-{{ section.id }} {
    position: relative;
    font-family: Arial, Helvetica, sans-serif;
  }

  /* ---------- Barra superior: nombre de tienda ---------- */
  .hero-banner-{{ section.id }} .hero-banner__topbar {
    display: grid;
    align-items: center;
    grid-template-columns: 30% 30% 30%;
    justify-content: space-between;
    padding: 16px 20px;
  }

  .hero-banner-{{ section.id }} .hero-banner__shop-name {
    position: absolute;
    left:0%;
    text-align: center;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    font-size: 15px;
    color: #111;
  }

  .hero-banner-{{ section.id }} .hero-banner__topbar-spacer {
    position: absolute;
    text-align: center;
    justify-self:center;
    justify-content: center;
    left:50%;
  }
  .hero-banner-{{ section.id }} .hero-banner__button_topBar {
    position: absolute;
    text-align: right;
    background-color: rgba(255, 245, 69);
    border-radius:900px;
    right:0%;
    span{
      font-weight: bold;
    }
  }

  /* ---------- Texto: mobile-first = flujo normal arriba de la imagen ---------- */
  .hero-banner-{{ section.id }} .hero-banner__text {
    display: grid;
    template-arrow
    padding: 4px 20px 20px;
  }

  .hero-banner-{{ section.id }} .hero-banner__heading {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(24px, 7vw, 32px);
    line-height: 1.1;
    font-weight: 700;
    margin: 0 0 10px;
    color: #111;
  }

  .hero-banner-{{ section.id }} .hero-banner__description {
    font-size: 14px;
    line-height: 1.5;
    color: #333;
    margin: 0;
  }

  /* ---------- Imagen ---------- */
  .hero-banner-{{ section.id }} .hero-banner__media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #f5f4f0;
  }

  .hero-banner-{{ section.id }} .hero-banner__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* ---------- Botón: mobile = centrado sobre la imagen ---------- */
  .hero-banner-{{ section.id }} .hero-banner__button {
    position: absolute;
    left: 50%;
    bottom: 20px;
    transform: translateX(-50%);
    overflow: hidden;
    isolation: isolate;
    background: #000;
    color: #fff;
    border-radius: 999px;
    padding: 13px 22px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.35s ease;
  }

  .hero-banner-{{ section.id }} .hero-banner__button-label {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  /* Franja amarilla que nace desde la izquierda y cubre el botón en hover */
  .hero-banner-{{ section.id }} .hero-banner__button::before{
    content: "";
    position: absolute;
    inset: 0;
    background: #f5e400;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.35s ease;
    z-index: 1;
  }

  .hero-banner-{{ section.id }} .hero-banner__button:hover,
  .hero-banner-{{ section.id }} .hero-banner__button:focus-visible {
    color: #000;
  }

  .hero-banner-{{ section.id }} .hero-banner__button:hover::before,
  .hero-banner-{{ section.id }} .hero-banner__button:focus-visible::before {
    transform: scaleX(1);
  }

  .hero-banner-{{ section.id }} .hero-banner__button--disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .hero-banner-{{ section.id }} .hero-banner__button--disabled:hover::before {
    transform: scaleX(0);
  }

  .hero-banner-{{ section.id }} .hero-banner__marquee {
    display: flex;
    background-color: rgba(245, 245, 245);
    color: #000;
    justify-content: center;
    overflow: hidden;
    white-space: nowrap;
    padding: 10px 0;
  }
  @media screen and (min-width: 750px) {
    .hero-banner-{{ section.id }} .hero-banner__topbar {
      padding: 20px 40px;
    }

    .hero-banner-{{ section.id }} .hero-banner__shop-name {
      text-align: left;
      flex: none;
    }

    .hero-banner-{{ section.id }} .hero-banner__media {
      aspect-ratio: 21 / 9;
    }

    .hero-banner-{{ section.id }} .hero-banner__text {
      position: absolute;
      left: 0;
      bottom: 0;
      z-index: 2;
      max-width: 480px;
      padding: 32px 40px 96px;
      pointer-events: none;
    }

    .hero-banner-{{ section.id }} .hero-banner__heading {
      font-size: clamp(36px, 4vw, 56px);
    }

    .hero-banner-{{ section.id }} .hero-banner__description {
      max-width: 340px;
    }

    .hero-banner-{{ section.id }} .hero-banner__button {
      left: 40px;
      bottom: 40px;
      transform: none;
      pointer-events: auto;
    }
  }
{% endstyle %}

