{% style %}
    .grid-title{
        font-family: Arial, Helvetica, sans-serif;
        font-weight: bold;
        font-size: large;        
    }
    .grid-content{
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        grid-gap: 10vw;
        .grid-item{
            position: relative;
            img{
            object-fit: cover;
            width: 100%;
            height:100%;
            };
            .popUp-container{
                position: absolute;
                top: 50%;
                left: 50%;
                button{
                    border-radius:900px;
                };
            };
        };
    }
    .hidden{
        display: none;
    }
    
{% endstyle %}

<script>
    let variantValueGlobal = {
        color: "",
        size: "",
        id: 0
    };
    document.getElementById("variant-size-value").addEventListener("change", () => {
        variantValue.size = document.getElementById("variant-size-value").value
    });

    function addToCart(productVariants){
        let variant = productVariants.find((variants) => {
            [variants.option1, variants.option2]
            .filter({
                (v) => v !== null &&
                variantValueGlobal.color == variants.option1 &&
                variantValueGlobal.size == variants.option2
            })
        })
        return fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ id: variant.id, quantity: 1 })
        }).then(function (res) {
            return res.json().then(function (data) {
                if (!res.ok) throw data;
                document.dispatchEvent(new CustomEvent('cart:updated'));
                return data;
        });
    };

    function selectVariant(variantValue) {
        variantValueGlobal.color = variantValue;
    };

    function showForm(productId){
        let popUp = document.getElementById(`${productId}-content`);
        popUp.style.display = "block";
    };
</script>

{% comment %} We define the grid container and then the title and the contents {% endcomment %}
<div class="grid-container">
    <div class="grid-title">
        {{ section.settings.gridTitle }}
    </div>
    <div class="grid-content">
        {% comment %} If the has blocks (products) then we display them {% endcomment %}
        {% if section.blocks.size > 0 %}
            {% for block in section.blocks %}
                {% comment %} product is the current product in the loop {% endcomment %}
                {% assign product = block.settings.product %}
                <div class="grid-item">
                    <div class="imageWrapper">
                        {% comment %} Display the product image if it exists, if not display a placeholder {% endcomment %}
                        {% if product.featured_image != blank %}
                            <img src="{{ product.featured_image | image_url: width:600 }}"
                                 alt="{{ product.title }}"
                                width="600" height="600">
                        {% else %}
                            <img src="{{ "no-image.png" | asset_url }}" width="600" height="600" alt="No image available">
                        {% endif %}
                        {% comment %} Create the popup container to select the variant and add it to the cart {% endcomment %}
                        <div class="popUp-container">
                            <button 
                                onclick="showForm({{ product.id }})"
                                id="{{ product.id }}-popUp"    
                            >+</button>   
                            {% comment %} On the menu they can view the description, price and the name of the product
                             also they can decide the color and size {% endcomment %}
                                <div 
                                    id="{{ product.id }}-content"
                                    style="display:none"
                                    class="popUp-content">
                                    <div class="productInfo">
                                        <div class="product-imageWrapper">
                                            <img src="{{ product.featured_image | image_url: width:600 }}"
                                                 alt="{{ product.title }}"
                                                width="600" height="600">
                                        </div>
                                        <div class="Productdetails">
                                            <div class="product-title">
                                                {{ product.title }}
                                            </div>
                                            <div class="product-price">
                                                {{ product.price | money }}
                                            </div>
                                            <div class="product-description">
                                                {{ product.description }}
                                            </div>
                                        </div>
                                    </div>
                                    <div class="variant-options">
                                        <div class="variant-colors">
                                            {% comment %} Display the available color options for the product {% endcomment %}
                                             {% assign colorOption = product.options_by_name["Color"]%}
                                             <button onclick="selectVariant({{ colorOption.selected_value }})" class="button-variant-option">
                                                {% comment %} We use the current value to define the background color {% endcomment %}
                                                <div class="variant-color-style" style="background-color: {{ colorOption.selected_value }}"></div>
                                                {% for colorValues in colorOption.values %}
                                                    <div class="variant-color-name">
                                                        <p class="variant-color-text">{{ colorOption.selected_value }}</p>
                                                    </div>
                                                {% endfor %}
                                             </button>
                                        </div>
                                        <div class="variant-size">
                                            {% comment %} Display the available size options for the product {% endcomment %}
                                            {% assign sizeOption = product.options_by_name["Size"] %}
                                            <select class="variant-size-text" id="variant-size-value">
                                                <p class="variant-size-text">{{ sizeOption.selected_values }}</p>
                                                {% for values in sizeOption.values %}
                                                    <option value={{ values }} class="variant-size-text"></option>
                                                {% endfor %}
                                            </select>
                                        </div>
                                        {% comment %} Display the "Add to Cart" button {% endcomment %}
                                        <div class="addToCart" onclick="addToCart({{ product.variants }})">
                                            Add to Cart
                                            <span class="arrow-icon">🛒</span>
                                        </div>
                                    </div>
                                </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        {% else %}
            <div class="grid-item">
                <p class="grid-text">No products added</p>  
            </div>    
        {% endif %}
    </div>
</div>




{% schema %}
    {
    "name": "Grid",
    "settings": 
    [
        {
            "type": "header",
            "content": "Grid"
        },
        {
            "type": "text",
            "id": "gridTitle",
            "label": "Grid Title",
            "default": "Grid Title"
        }
    ],
    "blocks": [
        {
            "type": "product",
            "name": "Product",
            "settings":[
                {
                    "type": "product",
                    "id": "productHeader",
                    "label": "Product Header"
                }
            ]
        }
    ],
    "max_blocks": 9,
    "presets": [
        {
            "name": "Grid"
        }
    ]    
}
{% endschema %}